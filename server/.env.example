# ==========================================
# APRAMEYA SERVER ENVIRONMENT TEMPLATE (.env.example)
# ==========================================

# Server Port
PORT=5001

# MongoDB Connection String (Atlas Cluster or local)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>"

# Session Security Key
SESSION_SECRET="your-session-secret-key-here"

# Node Environment ('development' or 'production')
NODE_ENV="development"

# Client Allowed Origins
CLIENT_ORIGIN="http://localhost:5173,https://aprameya-asc.vercel.app,https://aprameya.kluniversity.me"

# QR Ticket Verification Security
QR_SECRET="aprameya-qr-secret-key"
QR_EXPIRY_DAYS=30

# Optional SMTP Email Service Settings
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="aprameya.techclub@kluniversity.in"
